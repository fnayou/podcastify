# OpenCode config (contributor tooling; see AGENTS.md)
OPENCODE_CONFIG=.opencode/opencode.json

# Host vs container ports
HOST_PORT=8080
SERVICE_PORT=8080

# Public base URL used inside the generated RSS
PUBLIC_BASE_URL=http://localhost:${HOST_PORT}

# In-container paths (don’t change unless you know why)
PODCASTS_ROOT=/app/podcasts
PUBLIC_ROOT=/app/public
CACHE_ROOT=/app/.cache

# Runtime user — set to the uid/gid that owns ./public, ./podcasts, ./cache so
# generated files aren't written as root. Run `id -u` / `id -g` to find them.
PUID=1000
PGID=1000

# Generator behavior
RUN_ON_START=true
PUBLISH_XML=true

# Logging
LOG_LEVEL=INFO
