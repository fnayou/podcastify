# Host vs container ports
HOST_PORT=8080
SERVICE_PORT=8080

# Public base URL used inside the generated RSS
PUBLIC_BASE_URL=http://localhost:${HOST_PORT}

# Runtime user — set to the uid/gid that owns ./public, ./podcasts, ./cache so
# generated files aren't written as root. Run `id -u` / `id -g` to find them.
PUID=1000
PGID=1000

# Generator behavior
RUN_ON_START=true
# Seconds between checks for new or changed configs and media; 0 = off
GENERATE_INTERVAL=0
PUBLISH_XML=true
# Opt-in page at / listing your feeds; anyone who can reach the server can then
# discover feed names. Only takes effect while PUBLISH_XML is on.
PUBLISH_INDEX=false

# Logging
LOG_LEVEL=INFO
